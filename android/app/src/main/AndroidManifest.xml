<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 应用清单（AndroidManifest.xml）
  向系统声明：应用名称、图标、入口页面、权限等。
  版本号与包名（applicationId）在 pubspec.yaml / build.gradle.kts 中配置，不在此文件。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 整个应用的全局配置 -->
    <application
        android:label="HealthLive"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!--
          android:label          桌面显示名，安装后图标下方显示的文字
          android:name           Application 类名；${applicationName} 由 Flutter 构建时注入
          android:icon           应用图标，对应 res/mipmap-*/ic_launcher.png
        -->

        <!-- Flutter 单 Activity 架构：唯一的主窗口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!--
              android:name                 Activity 类；.MainActivity 即包名下的 MainActivity.kt
              android:exported             是否允许外部通过 Intent 启动；主入口必须为 true
              android:launchMode           singleTop：栈顶已有实例时复用，不重复创建
              android:taskAffinity         任务栈亲和性；留空使用系统默认
              android:theme                冷启动闪屏主题（Flutter 引擎初始化前显示）
              android:configChanges        旋转/语言等变更时不销毁 Activity，由 Flutter 处理
              android:hardwareAccelerated  开启 GPU 硬件加速
              android:windowSoftInputMode  软键盘弹出时压缩布局，避免输入框被遮挡
            -->

            <!-- Flutter UI 就绪后使用的正常主题，定义在 res/values/styles.xml -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- 启动过滤器：MAIN + LAUNCHER = 桌面图标点击入口 -->
            <intent-filter>
                <!-- 标记为主入口 -->
                <action android:name="android.intent.action.MAIN" />
                <!-- 出现在桌面启动器 -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter 嵌入层 v2 标记；删除会导致插件注册失败，勿删 -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android 11+ 包可见性：允许查询能处理纯文本的组件（ProcessTextPlugin 需要） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
